# Koneksi MongoDB. Gunakan replica set (mis. ?replicaSet=rs0) agar transaksi
# multi-dokumen aktif; standalone tetap berjalan dengan mode kompensasi.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=koperasi_db
# auto | on | off
MONGODB_TRANSACTIONS=auto

# WAJIB diganti: string acak panjang (mis. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET_KEY=ganti-dengan-secret-acak-yang-panjang
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Asia/Jakarta

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Admin awal untuk `python -m app.seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_EMAIL=admin@example.com
